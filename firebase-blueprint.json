{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user account details and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Cashier", "Manager", "Accountant", "Director", "Admin"] },
        "branchId": { "type": "string", "enum": ["Gyinyase", "Kasoa", "Madina", "Santasi", "ALL"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "branchId"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Employee records.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Cashier", "Manager", "Accountant", "Director", "Admin"] },
        "branchId": { "type": "string", "enum": ["Gyinyase", "Kasoa", "Madina", "Santasi"] },
        "phone": { "type": "string" },
        "basicSalary": { "type": "number" },
        "hireDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "hasUserAccount": { "type": "boolean" }
      },
      "required": ["email", "displayName", "role", "branchId"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory items.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "price": { "type": "number" },
        "stockLevel": { "type": "number" },
        "branchId": { "type": "string" }
      },
      "required": ["name", "price", "stockLevel", "branchId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles collection."
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Employee records collection."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Inventory products collection."
    }
  }
}
